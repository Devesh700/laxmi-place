rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read for room photos; all uploads/deletes go through firebase-admin.
    match /rooms/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
