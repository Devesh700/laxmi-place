# Public site URL (used for metadataBase, canonical URLs, sitemap, and JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Admin SDK (server-only, used in Phase 5)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Admin dev-token gate (long random string, never prefix with NEXT_PUBLIC_)
ADMIN_DEV_TOKEN=devtoken
